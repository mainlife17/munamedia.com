{
  "scripts": {
    "dev": "astro dev",
    "build": "npm run studio:build && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "studio:dev": "sanity dev",
    "studio:build": "sanity build public/studio && rm -rf public/static && cp -R public/studio/static public/static",
    "studio:deploy": "sanity deploy",
    "sanity:seed:generate": "tsx scripts/generate-sanity-seed.ts",
    "sanity:seed:import": "npm run sanity:seed:generate && sanity dataset import sanity/seed/muna-media-seed.ndjson production --replace",
    "sanity:dataset:create": "sanity dataset create production --visibility public",
    "sanity:cors:add": "sanity cors add https://munaagency.com --credentials"
  },
  "dependencies": {
    "@astrojs/sitemap": "latest",
    "@portabletext/react": "^6.2.0",
    "@sanity/astro": "^3.4.1",
    "@sanity/client": "^7.22.1",
    "@sanity/vision": "^5.31.1",
    "astro": "latest",
    "sanity": "^5.31.1",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
