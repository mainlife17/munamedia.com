<form class="lead-form" id="lead-form">
  <div class="form-grid">
    <label>Name<input name="name" required autocomplete="name" /></label>
    <label>Company<input name="company" required autocomplete="organization" /></label>
    <label>Email<input type="email" name="email" required autocomplete="email" /></label>
    <label>Phone or Telegram<input name="phone" autocomplete="tel" /></label>
    <label>Target market<select name="market"><option>Uzbekistan</option><option>Central Asia</option><option>Kazakhstan</option><option>Kyrgyzstan</option><option>Tajikistan</option><option>Not sure yet</option></select></label>
    <label>Primary need<select name="budget"><option>90-day market entry plan</option><option>Open-book media buying</option><option>Performance marketing</option><option>Telegram marketing</option><option>Influencer campaign</option><option>OOH / offline activation</option><option>Campaign audit</option></select></label>
  </div>
  <label>What do you want to launch or improve?<textarea name="message" rows="5" required placeholder="Market, product, timing, approximate budget, current challenge"></textarea></label>
  <input type="hidden" name="source" value="munaagency.com" />
  <button class="button" type="submit" data-track="cta_click" data-cta="lead_form_submit_click">Send brief</button>
  <p class="form-status" id="form-status">We will reply from info@munamedia.me. Tender requests: brief@munamedia.me. Careers: job@munamedia.me.</p>
</form>
<script>
  const form = document.querySelector('#lead-form');
  const status = document.querySelector('#form-status');
  const track = (event: string, payload: Record<string, unknown>) => window.mmTrack?.(event, payload);

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    const started = { value: false };
    form.addEventListener('input', () => {
      if (!started.value) {
        started.value = true;
        const data = Object.fromEntries(new FormData(form));
        track('form_start', { form_id: 'lead-form', market: data.market, primary_need: data.budget });
      }
    }, { once: true });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = 'Sending...';
      const data = Object.fromEntries(new FormData(form));
      try {
        const response = await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (!response.ok) throw new Error('Request failed');
        track('generate_lead', { form_id: 'lead-form', market: data.market, primary_need: data.budget });
        form.reset();
        status.textContent = 'Thank you. We received your request and will contact you soon.';
      } catch (error) {
        track('form_error', { form_id: 'lead-form', market: data.market, primary_need: data.budget });
        const subject = encodeURIComponent('Muna Media brief');
        const body = encodeURIComponent(Object.entries(data).map(([k, v]) => `${k}: ${v}`).join('\n'));
        window.location.href = `mailto:info@munamedia.me?subject=${subject}&body=${body}`;
        status.textContent = 'If the form did not send, your email client will open as fallback.';
      }
    });
  }
</script>
