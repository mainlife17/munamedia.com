---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { getSeoPages, getCaseStudies } from '../lib/content';
export async function getStaticPaths() {
  const pages = await getSeoPages();
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const caseStudies = await getCaseStudies();
const relatedCases = caseStudies
  .filter((study) => study.services.some((service) => page.services.join(' ').toLowerCase().includes(service.split(' ')[0].toLowerCase())) || study.market.toLowerCase().includes(page.markets[0]?.toLowerCase() || ''))
  .slice(0, 3);
const isService = page.slug.startsWith('services/');
const isIndustry = page.slug.startsWith('industries/');
const isSolution = page.slug.startsWith('solutions/');
const pageTypeLabel = isService ? 'Service page' : isIndustry ? 'Industry solution' : isSolution ? 'Solution' : 'Market page';
const primaryCta = isService || isSolution ? 'Request a 90-day plan' : 'Request a market plan';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } }))
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.h1,
  description: page.description,
  provider: { '@type': 'Organization', name: 'Muna Media', url: 'https://munaagency.com' },
  areaServed: page.markets.map((market) => ({ '@type': 'Place', name: market })),
  serviceType: page.services
};
---
<BaseLayout title={page.title} description={page.description} canonical={`/${page.slug}/`}>
  <main>
    <section class="page-hero upgraded-page-hero">
      <p class="eyebrow">{page.eyebrow} · {pageTypeLabel}</p>
      <h1>{page.h1}</h1>
      <p class="lead">{page.intro}</p>
      <div class="hero-actions">
        <a class="button" href="#contact" data-track="cta_click" data-cta={`${page.slug}_request_plan`}>{primaryCta}</a>
        <a class="button ghost" href="/case-studies/" data-track="cta_click" data-cta={`${page.slug}_view_cases`}>View case studies</a>
      </div>
    </section>

    <section class="section split decision-section">
      <div>
        <p class="eyebrow">Best fit</p>
        <h2>Use this when you need accountable regional execution.</h2>
        <p>This is for teams that need a practical launch or growth system in Central Asia: clear channel logic, budget control, local coordination and reporting that management can use.</p>
        {page.markets.map((item) => <span class="tag">{item}</span>)}
      </div>
      <div>
        <p class="eyebrow">What is included</p>
        <h2>Scope of work</h2>
        <p>Each engagement connects strategy, launch tasks, optimization and reporting instead of leaving the client to coordinate separate vendors.</p>
        {page.services.map((item) => <span class="tag">{item}</span>)}
      </div>
    </section>

    <section class="section dark">
      <p class="eyebrow">Why Muna Media</p>
      <h2>Built for enterprise teams that need control, not guesswork.</h2>
      <div class="standards-grid">
        <article><strong>Open book</strong><p>Media inventory cost and agency fees are visible separately.</p></article>
        <article><strong>18/7/365</strong><p>Response coverage for active campaign operations.</p></article>
        <article><strong>15 min</strong><p>Response SLA for active campaign teams.</p></article>
        <article><strong>Minora AI</strong><p>Campaign status, spend and performance signals in live dashboards.</p></article>
      </div>
    </section>

    <section class="section cards proof-cards">
      <div class="section-heading"><p class="eyebrow">Proof points</p><h2>What this solves for the client</h2></div>
      {page.proof.map((item) => <article><h3>{item}</h3><p>We translate this into budget logic, owners, timeline, reporting cadence and next actions.</p></article>)}
    </section>

    <section class="section split lead-magnet deliverable-block">
      <div>
        <p class="eyebrow">First deliverable</p>
        <h2>Start with a 90-day action plan.</h2>
        <p>Before scaling budget, we map channels, local risks, measurement, execution tasks and decision points. The plan is built for launch teams, country managers, CMOs and procurement.</p>
      </div>
      <div class="dashboard-card light-card">
        <span>Includes</span><strong>channels, risks, budget logic and timeline</strong>
        <span>Output</span><strong>execution-ready plan, not a generic deck</strong>
      </div>
    </section>

    {relatedCases.length > 0 && (
      <section class="section cards">
        <div class="section-heading"><p class="eyebrow">Related case studies</p><h2>Relevant execution examples</h2></div>
        {relatedCases.map((study) => <article><p class="eyebrow">{study.industry}</p><h3>{study.client}</h3><p>{study.headline}</p><a href={`/cases/${study.slug}/`}>Read case</a></article>)}
      </section>
    )}

    <section class="section faq"><h2>FAQ</h2>{page.faqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>
    <section class="section contact" id="contact"><div><p class="eyebrow">Discuss this market</p><h2>Send a brief to Muna Media</h2><p>We will reply with a recommended next step: market diagnostic, media plan, audit or proposal. Tender requests can go to brief@munamedia.me.</p></div><LeadForm /></section>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </main>
</BaseLayout>
