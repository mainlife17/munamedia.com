---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCaseStudies } from '../lib/content';
const caseStudies = await getCaseStudies();
const title = 'Case Studies | Muna Media';
const description = 'Selected Muna Media case studies across fintech, payments, foodtech, consumer electronics, OOH, Telegram marketing and Central Asia market entry.';
const industries = Array.from(new Set(caseStudies.map((item) => item.industry)));
const proofCases = caseStudies.filter((item) => item.publicEvidence?.length).slice(0, 6);
---
<BaseLayout title={title} description={description} canonical="/case-studies/">
  <main>
    <section class="page-hero">
      <p class="eyebrow">Case studies</p>
      <h1>Public case files for market entry, media and local execution.</h1>
      <p class="lead">Each case is structured for enterprise buyers: business goal, operating scope, disclosed evidence, execution model and the data still needed before a final board-level deck.</p>
    </section>

    <section class="section split case-library-intro">
      <div>
        <p class="eyebrow">Industries covered</p>
        <div class="strip inline-strip">{industries.map((industry) => <span>{industry}</span>)}</div>
      </div>
      <div>
        <p class="eyebrow">Editorial rule</p>
        <h2>No invented numbers.</h2>
        <p>Metrics are published only when they appear in public source material or have explicit client approval. Everything else is marked as data to add next.</p>
      </div>
    </section>

    {proofCases.length > 0 && (
      <section class="section dark">
        <p class="eyebrow">Disclosed proof points</p>
        <h2>Examples with public evidence.</h2>
        <div class="standards-grid">
          {proofCases.map((study) => (
            <article>
              <strong>{study.client}</strong>
              <p>{study.publicEvidence?.[0]}</p>
              <a href={`/cases/${study.slug}/`}>Read case</a>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="section cards case-grid">
      {caseStudies.map((study) => (
        <article>
          <p class="eyebrow">{study.industry} · {study.market}{study.year ? ` · ${study.year}` : ''}</p>
          <h2>{study.client}</h2>
          <p>{study.headline}</p>
          {study.businessGoal && <p class="muted"><b>Goal:</b> {study.businessGoal}</p>}
          <div>{study.services.slice(0, 3).map((service) => <span class="tag">{service}</span>)}</div>
          <a href={`/cases/${study.slug}/`} data-track="cta_click" data-cta={`case_${study.slug}`}>Read case</a>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
